{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://resistancezero.com/data/conv-limits.schema.json",
  "title": "Conventional point limits (curated)",
  "description": "One row per point with an operating limit (PRD-CONV-POINT-STATUS-TREND §5). Bounds may be null; where set, lo_alarm <= lo_warn < hi_warn <= hi_alarm (checked by tools/test-conv-point-status-core.mjs, which a JSON schema cannot express). The builder copies each row into data/conv-parameters.json `limits`.",
  "type": "object",
  "required": ["rows"],
  "additionalProperties": false,
  "properties": {
    "description": { "type": "string" },
    "schema": { "type": "string" },
    "rows": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/limit" } }
  },
  "definitions": {
    "limit": {
      "type": "object",
      "required": ["id", "label", "unit", "lo_alarm", "lo_warn", "hi_warn", "hi_alarm", "deadband", "nominal", "basis", "evidenceClass", "source"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)+$" },
        "label": { "type": "string" },
        "unit": { "type": "string" },
        "lo_alarm": { "type": ["number", "null"] },
        "lo_warn": { "type": ["number", "null"] },
        "hi_warn": { "type": ["number", "null"] },
        "hi_alarm": { "type": ["number", "null"] },
        "deadband": { "type": "number" },
        "nominal": {
          "type": "object",
          "required": ["value", "ref"],
          "additionalProperties": false,
          "properties": { "value": { "type": "number" }, "ref": { "type": "string" } }
        },
        "basis": { "type": "string" },
        "evidenceClass": { "enum": ["MEASURED", "DERIVED", "SIMULATED", "ADOPTED", "ASSUMED", "VENDOR", "STANDARD", "UNAVAILABLE"] },
        "source": {
          "type": "object",
          "required": ["ref", "asOf"],
          "additionalProperties": false,
          "properties": {
            "ref": { "type": "string" },
            "section": { "type": "string" },
            "asOf": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
          }
        },
        "migratedFrom": { "type": "string" }
      }
    }
  }
}
