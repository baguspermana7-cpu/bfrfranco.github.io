{
  "version": 1,
  "about": "One entry per calculator page (<body data-rz-calc>). Shared by every feature that needs to know a calculator's page, its project fields and its headline results (ARCHITECTURE-P C1). Checked against the rendered pages by tools/test-calculator-registry.mjs. fields: project quantities mapped to the page's own input id; factor converts the page unit to the registry unit (it_load in kW). results: headline outputs; selector must resolve to exactly one element that shows a number after load. Other per-calculator lists (PDF sections, sensitivity factors, manual links, embed keep-list, hand-off) are added by the feature that first needs them, in the same release as that feature.",
  "calculators": [
    { "calc": "capex", "page": "capex-calculator.html", "title": "CAPEX Calculator",
      "manual": { "page": "manual/capex.html", "anchor": "inputs", "groups": ".section-title" },
      "fields": { "it_load": { "id": "itLoad", "unit": "kW", "factor": 1 } },
      "results": [ { "key": "capex_total", "selector": "#totalCost", "unit": "USD", "better": "lower" },
                   { "key": "energy_cost_annual", "selector": "#energyCost", "unit": "USD/yr", "better": "lower" } ] },
    { "calc": "opex", "page": "opex-calculator.html", "title": "OPEX Calculator",
      "manual": { "page": "manual/opex.html", "anchor": "inputs", "groups": ".section-title" },
      "fields": { "it_load": { "id": "itLoad", "unit": "kW", "factor": 1 },
                  "pue": { "id": "pueSlider", "unit": "ratio", "factor": 1 },
                  "country": { "id": "countrySelect", "format": "iso2+region" },
                  "tier": { "id": "tierLevel", "format": "digit" } },
      "results": [ { "key": "opex_annual", "selector": "#totalOpex", "unit": "USD/yr", "better": "lower" },
                   { "key": "opex_per_kw", "selector": "#perKwOpex", "unit": "USD/kW/yr", "better": "lower" } ] },
    { "calc": "tco", "page": "tco-calculator.html", "title": "TCO Calculator",
      "manual": { "page": "manual/tco.html", "anchor": "inputs", "groups": ".section-title" },
      "fields": { "it_load": { "id": "tcoItLoad", "unit": "MW", "factor": 1000 },
                  "pue": { "id": "tcoPue", "unit": "ratio", "factor": 1 },
                  "tier": { "id": "tcoTier", "format": "tier-n" } },
      "results": [ { "key": "tco_build", "selector": "#kpiBuildTco", "unit": "USD", "better": "lower" },
                   { "key": "tco_colo", "selector": "#kpiColoTco", "unit": "USD", "better": "lower" },
                   { "key": "tco_cloud", "selector": "#kpiCloudTco", "unit": "USD", "better": "lower" } ] },
    { "calc": "roi", "page": "roi-calculator.html", "title": "ROI Calculator",
      "manual": { "page": "manual/roi.html", "anchor": "inputs", "groups": ".section-title" },
      "fields": { "it_load": { "id": "itCapacity", "unit": "MW", "factor": 1000 },
                  "pue": { "id": "pueValue", "unit": "ratio", "factor": 1 } },
      "results": [ { "key": "npv", "selector": "#primaryValue", "unit": "USD", "better": "higher" },
                   { "key": "irr", "selector": "#metIRR", "unit": "%", "better": "higher" } ],
      "consumes": { "totalCapex": { "from": "capex.capex_total", "factor": 1000000, "label": "CAPEX Calculator" } },
      "sensitivity": { "result": "#primaryValue", "unit": "", "anchor": "section.calculator-section",
        "factors": [ { "id": "revenuePerKw", "label": "Revenue per kW", "kind": "continuous" }, { "id": "occMax", "label": "Stabilised occupancy", "kind": "continuous" },
                     { "id": "occYear1", "label": "Year-1 occupancy", "kind": "continuous" }, { "id": "electricityRate", "label": "Electricity rate", "kind": "continuous" },
                     { "id": "pueValue", "label": "PUE", "kind": "continuous" }, { "id": "totalCapex", "label": "Total CAPEX", "kind": "continuous" },
                     { "id": "itCapacity", "label": "IT capacity", "kind": "continuous" }, { "id": "escalation", "label": "Revenue escalation", "kind": "continuous" },
                     { "id": "staffingCost", "label": "Staffing cost", "kind": "continuous" }, { "id": "maintenanceCost", "label": "Maintenance cost", "kind": "continuous" },
                     { "id": "interestRate", "label": "Interest rate", "kind": "continuous" }, { "id": "discountRate", "label": "Discount rate", "kind": "continuous" },
                     { "id": "taxRate", "label": "Tax rate", "kind": "continuous" }, { "id": "exitCapRate", "label": "Exit cap rate", "kind": "continuous" },
                     { "id": "debtRatio", "label": "Debt ratio", "kind": "step" }, { "id": "ancillaryPct", "label": "Ancillary revenue", "kind": "step" } ] } },
    { "calc": "pue", "page": "pue-calculator.html", "title": "PUE Calculator",
      "manual": { "page": "manual/pue.html", "anchor": "inputs", "groups": ".section-title" },
      "fields": { "it_load": { "id": "itLoad", "unit": "kW", "factor": 1 } },
      "results": [ { "key": "pue", "selector": "#pueValue", "unit": "ratio", "better": "lower" },
                   { "key": "facility_power", "selector": "#totalPowerValue", "unit": "kW", "better": "lower" },
                   { "key": "energy_annual", "selector": "#annualEnergyValue", "unit": "GWh/yr", "better": "lower" } ],
      "sensitivity": { "result": "#pueValue", "unit": "", "anchor": "section.calculator-section",
        "factors": [ { "id": "itLoad", "label": "IT load", "kind": "continuous" }, { "id": "rackDensity", "label": "Rack density", "kind": "step" },
                     { "id": "rackCount", "label": "Rack count", "kind": "continuous" }, { "id": "coolingType", "label": "Cooling type", "kind": "step" },
                     { "id": "containment", "label": "Containment", "kind": "step" }, { "id": "climateZone", "label": "Climate zone", "kind": "step" },
                     { "id": "upsType", "label": "UPS type", "kind": "step" }, { "id": "upsLoadFactor", "label": "UPS load factor", "kind": "continuous" },
                     { "id": "redundancy", "label": "Redundancy", "kind": "step" }, { "id": "lighting", "label": "Lighting", "kind": "step" },
                     { "id": "security", "label": "Security systems", "kind": "step" }, { "id": "fire", "label": "Fire systems", "kind": "step" },
                     { "id": "utilization", "label": "IT utilisation", "kind": "continuous" }, { "id": "economizer", "label": "Economizer", "kind": "step" },
                     { "id": "supplyTemp", "label": "Supply air temperature", "kind": "continuous" }, { "id": "transformerLoss", "label": "Transformer loss", "kind": "continuous" },
                     { "id": "pduType", "label": "PDU type", "kind": "step" }, { "id": "loadGrowth", "label": "Load growth", "kind": "continuous" },
                     { "id": "greenGridLevel", "label": "Green Grid measurement level", "kind": "step" }, { "id": "ashraeClass", "label": "ASHRAE class", "kind": "step" } ] } },
    { "calc": "carbon", "page": "carbon-footprint.html", "title": "Carbon Footprint Calculator",
      "manual": { "page": "manual/carbon.html", "anchor": "inputs", "groups": ".cf-tab-content > .input-section" },
      "fields": { "it_load": { "id": "itLoad", "unit": "kW", "factor": 1 },
                  "pue": { "id": "pueValue", "unit": "ratio", "factor": 1 },
                  "country": { "id": "countrySelect", "format": "iso2" } },
      "results": [ { "key": "emissions_annual", "selector": "#primaryValue", "unit": "tCO2e/yr", "better": "lower" },
                   { "key": "scope2", "selector": "#metScope2", "unit": "tCO2e/yr", "better": "lower" } ],
      "sensitivity": { "result": "#primaryValue", "unit": "tCO2e/yr", "anchor": "section.calculator-section",
        "note": "Moves each input by 10 % down and up (a select: the option before and after) and recomputes this page. Grid intensity follows the country, so the country row moves it to the neighbouring entries in the list.",
        "factors": [ { "id": "itLoad", "label": "IT load", "kind": "continuous" }, { "id": "pueValue", "label": "PUE", "kind": "continuous" },
                     { "id": "countrySelect", "label": "Country (sets grid intensity)", "kind": "step" }, { "id": "renewablePct", "label": "Renewable share", "kind": "continuous" },
                     { "id": "renewableType", "label": "Renewable type", "kind": "step" }, { "id": "genHours", "label": "Generator run hours", "kind": "continuous" },
                     { "id": "genType", "label": "Generator type", "kind": "step" }, { "id": "coolingType", "label": "Cooling type", "kind": "step" },
                     { "id": "gwpValue", "label": "Refrigerant GWP", "kind": "continuous" }, { "id": "chargePerKw", "label": "Refrigerant charge per kW", "kind": "continuous" },
                     { "id": "leakRate", "label": "Refrigerant leak rate", "kind": "continuous" } ] } },
    { "calc": "cx", "page": "cx-calculator.html", "title": "Commissioning Cost Calculator",
      "manual": { "page": "manual/cx.html", "anchor": "inputs", "groups": "#cxInputsGrid .in-group > h2" },
      "fields": { "it_load": { "id": "cxItLoad", "unit": "kW", "factor": 1 } },
      "results": [ { "key": "cx_cost", "selector": "#cxKpiTotal", "unit": "USD", "better": "lower" },
                   { "key": "cx_weeks", "selector": "#cxKpiWeeks", "unit": "weeks", "better": "lower" },
                   { "key": "cx_per_kw", "selector": "#cxKpiPerKw", "unit": "USD/kW", "better": "lower" } ] },
    { "calc": "spares", "page": "spares-readiness-calculator.html", "title": "Spares Readiness Calculator",
      "manual": { "page": "manual/spares.html", "anchor": "inputs", "groups": ".sc-section-title:has(+ .input-row)" },
      "fields": {},
      "handoff": { "version": 1, "page": "spares-readiness-calculator.html", "params": [
          {"param":"from","type":"enum","values":["tier","opex","tco","roi","pue","incident"],"targets":[],"labels":{"tier":"Tier Advisor","opex":"OPEX Calculator","tco":"TCO Calculator","roi":"ROI Calculator","pue":"PUE Calculator","incident":"incident analysis"}},
          {"param":"tier","type":"int","min":1,"max":4,"targets":["c1_redundancy"],"transform":"tier-to-redundancy","map":{"1":"n","2":"n1","3":"n1","4":"2n"}},
          {"param":"redundancy","type":"enum","case":"lower","values":["n","n1","2n"],"targets":["c1_redundancy"],"labels":{"n":"N","n1":"N+1","2n":"2N"}},
          {"param":"mtbf","type":"float","min":0.1,"max":1000,"unit":"years","targets":["c1_lambda"],"transform":"reciprocal"},
          {"param":"mttr","type":"float","min":1,"max":8760,"unit":"hours","targets":["mc_mttr"]},
          {"param":"downtimeCostPerHr","type":"float","min":1,"max":10000000,"unit":"USD/h","targets":["mc_downtime_cost","s_understk_cost"]},
          {"param":"country","type":"enum","case":"upper","values":["US","GB","DE","FR","AU","IN","SG","ID","JP","BR","CN","MY"],"targets":["r_lt_weeks","s_lt_weeks","s_carry_rate","ltb_carry_rate"]},
          {"param":"itLoad","type":"float","min":1,"max":1000000,"unit":"kW","targets":[]},
          {"param":"commodity","type":"enum","case":"lower","values":["chiller","crac","ups","switchgear","transformer","generator","pump","hx","cooling-tower","bms","fuel","fire","other"],"targets":["c1_commodity"]},
          {"param":"installedBase","type":"int","min":1,"max":1000,"targets":["c1_installed","s_installed_base","h_sites"]},
          {"param":"leadTime","type":"float","min":1,"max":260,"unit":"weeks","targets":["r_lt_weeks","s_lt_weeks","h_oem_lt","mc_lt_base"]},
          {"param":"unitCost","type":"float","min":1,"max":100000000,"unit":"USD","targets":["s_unit_cost","h_unit_cost","ltb_unit_cost"]} ] },
      "results": [ { "key": "readiness", "selector": "#sum_readiness", "unit": "score", "better": "higher" },
                   { "key": "rpn", "selector": "#c1_rpn", "unit": "RPN", "better": "lower" } ] },
    { "calc": "tier", "page": "tier-advisor.html", "title": "Tier Advisor",
      "manual": { "page": "manual/tier.html", "anchor": "inputs", "groups": ".section-title" },
      "fields": { "it_load": { "id": "itLoad", "unit": "kW", "factor": 1 } },
      "results": [ { "key": "tier_score", "selector": "#scoreValue", "unit": "score", "better": "higher" } ] },
    { "calc": "tia", "page": "tia-942-checklist.html", "title": "TIA-942 Checklist",
      "manual": { "page": "manual/tia-942-checklist.html", "anchor": "inputs", "groups": ".section-title" },
      "fields": {},
      "results": [ { "key": "tia_score", "selector": "#scoreValue", "unit": "score", "better": "higher" } ],
      "sensitivity": { "result": "#scoreValue", "unit": "%", "anchor": "section.calculator-section", "max": 15,
        "note": "Ticks each unmet item, one at a time, and recomputes this page. The items that would raise the compliance score most come first; gains are read at the page's own precision (whole percent).",
        "unmet": { "selector": "input[type=checkbox][id^=\"chk-\"]" } } },
    { "calc": "rfs", "page": "rfs-readiness-workbench.html", "title": "RFS Readiness Workbench",
      "manual": { "page": "manual/rfs.html", "anchor": "inputs", "groups": ".rfs-card-title" },
      "noCompare": "the page saves its own state to this browser on every change, so a hidden copy would overwrite your data",
      "fields": { "it_load": { "id": "rfsSetupLoad", "unit": "MW", "factor": 1000, "default": null } },
      "results": [ { "key": "rfs_readiness", "selector": "#rfsClOverallPct", "unit": "%", "better": "higher" } ] }
  ]
}
