  "modes": [
    {
      "id": "normal",
      "label": "Liquid free cooling",
      "kind": "normal",
      "entry": [
        {
          "text": "free-cooling margin P4 at least the edge band",
          "derived": "free_cooling_margin_k",
          "op": ">=",
          "value": 1,
          "unit": "K"
        }
      ],
      "actions": [
        "dry coolers hold the HTW supply at ambient + dry-cooler approach",
        "liquid-path trim chillers off",
        "fan speed follows the HTW supply"
      ],
      "exit": [
        {
          "to": "edge",
          "text": "margin P4 below the edge band",
          "derived": "free_cooling_margin_k",
          "op": "<",
          "value": 1,
          "unit": "K"
        }
      ],
      "assumed": {
        "value 1": "the 1 K edge band and hysteresis: no source states one; this model's choice (ASSUMED)"
      }
    },
    {
      "id": "edge",
      "label": "Free cooling at the edge",
      "kind": "alarm",
      "entry": [
        {
          "text": "0 ≤ margin P4 < 1 K",
          "derived": "free_cooling_margin_k",
          "op": "<",
          "value": 1,
          "unit": "K"
        }
      ],
      "actions": [
        "raise the alarm: free-cooling margin under 1 K",
        "pre-start one trim chiller so it is proven before the margin goes negative"
      ],
      "exit": [
        {
          "to": "mechanical",
          "text": "margin P4 below 0 K",
          "derived": "free_cooling_margin_k",
          "op": "<",
          "value": 0,
          "unit": "K"
        },
        {
          "to": "normal",
          "text": "margin back to the edge band",
          "derived": "free_cooling_margin_k",
          "op": ">=",
          "value": 1,
          "unit": "K"
        }
      ],
      "assumed": {
        "value 1": "the 1 K edge band and hysteresis: no source states one; this model's choice (ASSUMED)",
        "pre-start": "vendor practice, not modelled by the engine; the engine runs no liquid chiller at the edge"
      }
    },
    {
      "id": "mechanical",
      "label": "Mechanical (trim chillers)",
      "kind": "protection",
      "entry": [
        {
          "text": "margin P4 below 0 K",
          "derived": "free_cooling_margin_k",
          "op": "<",
          "value": 0,
          "unit": "K"
        }
      ],
      "actions": [
        "trim chillers make the HTW at TCS supply − CDU approach",
        "dry coolers reject the condenser heat as well",
        "liquid chiller power and the running count come from the engine"
      ],
      "exit": [
        {
          "to": "normal",
          "text": "margin back above the edge band (1 K hysteresis)",
          "derived": "free_cooling_margin_k",
          "op": ">=",
          "value": 1,
          "unit": "K"
        }
      ],
      "assumed": {
        "value 1": "the 1 K edge band and hysteresis: no source states one; this model's choice (ASSUMED)"
      },
      "notModelled": "how fast the chillers load up; the engine gives steady states only"
    }
  ],
